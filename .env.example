# Variables de entorno de ejemplo para Floor-Module
# Copia este archivo a .env según el servicio a ejecutar

# Base de datos PostgreSQL (conforme a docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=floor_module_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/floor_module_db?schema=public"

# Broker RabbitMQ (conforme a docker-compose.yml)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# INT-001: Configuración de enrutamiento y servicio de Floor-Module API
PORT=8085
GLOBAL_PREFIX=api/v1/floor
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
RABBITMQ_EXCHANGE=sala.events
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5174,http://localhost:8000

# Frontend (apps/web · Vite Module Federation salaApp)
WEB_PORT=5174
VITE_API_BASE_URL=
VITE_WS_URL=
VITE_USE_MOCKS=false
# Zona IANA del restaurante, independiente de la zona del navegador
VITE_RESTAURANT_TIME_ZONE=America/Merida

# Mantener el mismo valor que la tolerancia de No-show del backend (minutos)
VITE_RESERVA_NO_SHOW_TOLERANCIA_MINUTOS=15
