DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/floor_module_db?schema=public"

# INT-001: Configuración de enrutamiento y servicio
PORT=8085
GLOBAL_PREFIX=api/v1/floor
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
RABBITMQ_EXCHANGE=sala.events
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
