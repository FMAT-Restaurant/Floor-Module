# Configuración de integración Shell/Kong y Mock Service Worker (MSW) en apps/web
# Establece VITE_USE_MOCKS='true' para ejecutar con datos y eventos simulados,
# o 'false' para conectarse a Kong API Gateway (:8000) y WebSocket /sala (:8085).
# Vacíos por defecto para autodetectar el host del Shell (Kong) y del remoto (WebSocket).
VITE_API_BASE_URL=
VITE_AUTH_API_BASE_URL=
VITE_WS_URL=
VITE_USE_MOCKS=false
VITE_RESTAURANT_TIME_ZONE=America/Merida
VITE_RESERVA_NO_SHOW_TOLERANCIA_MINUTOS=15
VITE_DEV_AUTH_TOKEN=
