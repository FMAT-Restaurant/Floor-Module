# Mock Service Worker (MSW) en apps/web
# Establece a 'true' para ejecutar el frontend con respuestas y eventos simulados
# o 'false' para conectarse a @floor/api en vivo a través del proxy de Vite
VITE_USE_MOCKS=false
VITE_RESTAURANT_TIME_ZONE=America/Merida
VITE_RESERVA_NO_SHOW_TOLERANCIA_MINUTOS=15
VITE_DEV_AUTH_TOKEN=
